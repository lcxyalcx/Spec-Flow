# 浏览器直连 WebSocket 指标（可选；不设则默认 ws://当前主机:8000/ws/metrics）
# NEXT_PUBLIC_SPECFLOW_WS_ORIGIN=ws://127.0.0.1:8000

# 仅当网关不在本机 8000 时，供中间件转发 /api 与 /v1（与 SPECFLOW_API_INTERNAL 二选一即可）
# NEXT_PUBLIC_SPECFLOW_API_ORIGIN=http://127.0.0.1:8000

# Docker / 生产：Next 服务端转发到内网网关（运行时读取，见 middleware.ts）
# SPECFLOW_API_INTERNAL=http://specflow-api:8000

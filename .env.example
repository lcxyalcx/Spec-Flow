# 逗号分隔多个 OpenAI 兼容上游，实现 Failover（服务端默认；控制台可改用 X-SpecFlow-Base-Url 覆盖）
UPSTREAM_URLS=https://api.openai.com/v1
UPSTREAM_API_KEYS=sk-your-key-here

# 硅基流动示例（须含 /v1）：
# UPSTREAM_URLS=https://api.siliconflow.cn/v1
# UPSTREAM_API_KEYS=sk-你的硅基流动密钥
# DEFAULT_TARGET_MODEL=Qwen/Qwen2.5-7B-Instruct
# DEFAULT_DRAFT_MODEL=Qwen/Qwen2.5-7B-Instruct
# EMBEDDING_MODEL=BAAI/bge-m3

DEFAULT_TARGET_MODEL=gpt-4o-mini
DEFAULT_DRAFT_MODEL=gpt-4o-mini

# 看板成本估算（USD / 1M tokens），可按你的供应商价目调整
PRICE_TARGET_INPUT_PER_MTOK=2.5
PRICE_TARGET_OUTPUT_PER_MTOK=10.0
PRICE_DRAFT_INPUT_PER_MTOK=0.15
PRICE_DRAFT_OUTPUT_PER_MTOK=0.6

SEMANTIC_CACHE_MAX_ENTRIES=5000
SEMANTIC_SIMILARITY_THRESHOLD=0.92

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
